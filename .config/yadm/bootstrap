#!/bin/bash

set -euo pipefail

if [[ "$OSTYPE" != "darwin"* ]]; then
    echo "This script is intended for macOS only" >&2
    exit 1
fi

source "$HOME/.xdg.dirs"
source "$XDG_CONFIG_HOME/shell/xdg"
export HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"
export PATH="$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin:$PATH"

# mise must exist before it can run the remaining bootstrap phases.
if [[ ! -x "$HOMEBREW_PREFIX/bin/mise" ]]; then
    for arg in "$@"; do
        case "$arg" in
            -n|--dry-run|-h|--help)
                echo "Install mise with Homebrew before previewing bootstrap; nothing was changed." >&2
                exit 1
                ;;
        esac
    done
    "$HOMEBREW_PREFIX/bin/brew" install mise
fi

exec "$HOMEBREW_PREFIX/bin/mise" -C "$HOME" bootstrap "$@"
