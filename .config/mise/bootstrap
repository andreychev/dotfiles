#!/bin/bash

set -euo pipefail
IFS=$'\n\t'

# Logger function
log() {
    local level=$1
    shift
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] [$level] $*"
}

# Error handler
error_handler() {
    local line_num=$1
    local error_code=$2
    log "ERROR" "Failed at line ${line_num} with error code ${error_code}"
    exit "${error_code}"
}

trap 'error_handler ${LINENO} $?' ERR

# Check if running on macOS
check_macos() {
    if [[ "$OSTYPE" != "darwin"* ]]; then
        log "ERROR" "This script is intended for macOS only"
        exit 1
    fi
}

# One class policy for native bootstrap hooks and directly invoked phases.
read_machine_class() {
    local class
    if ! class=$(git config --no-includes --file "$XDG_DATA_HOME/yadm/repo.git/config" --get local.class); then
        log "ERROR" "Cannot read yadm local.class. Run: yadm config local.class home (or work)" >&2
        return 1
    fi
    case "$class" in
        home|work) printf '%s\n' "$class" ;;
        *)
            log "ERROR" "Invalid yadm local.class '$class'; expected home or work." >&2
            return 1
            ;;
    esac
}

# Load configuration
load_config() {
    cd "$HOME"
    source "$HOME"/.xdg.dirs
    source "$XDG_CONFIG_HOME"/shell/xdg
    export HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"
    export PATH="$HOME/.local/bin:$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin:$PATH"
}

# Install brew dependencies
install_brew_deps() {
    local class=$1
    log "INFO" "Installing brew dependencies (class: $class)..."
    "$HOMEBREW_PREFIX/bin/brew" bundle
    log "SUCCESS" "Brew dependencies installation completed"
}

# Configure docker-buildx
setup_docker_buildx() {
    log "INFO" "Configuring docker-buildx..."
    mkdir -p "$DOCKER_CONFIG/cli-plugins"
    ln -sfn "$HOMEBREW_PREFIX/opt/docker-buildx/bin/docker-buildx" "$DOCKER_CONFIG/cli-plugins/docker-buildx"
    log "SUCCESS" "Docker-buildx configured"
}

# Configure yadm
setup_yadm() {
    log "INFO" "Configuring yadm sparse-checkout..."
    "$HOMEBREW_PREFIX/bin/yadm" sparse-checkout init
    "$HOMEBREW_PREFIX/bin/yadm" sparse-checkout set --no-cone \
        '/*' '!README.md' '!LICENSE' '!.editorconfig' \
        '!MISE-ASSESSMENT.md' '!MACKUP-REMOVAL-PLAN.md' '!/tests/'
    log "SUCCESS" "Yadm configured"
}

main() {
    local phase=${1:-}
    case "$phase" in
        preflight|packages|finish) ;;
        *)
            log "ERROR" "Usage: $0 {preflight|packages|finish}"
            exit 1
            ;;
    esac

    check_macos
    load_config

    local class
    class=$(read_machine_class)
    if [[ "$phase" == "preflight" ]]; then
        return 0
    fi
    chmod 700 "$XDG_CONFIG_HOME"

    case "$phase" in
        packages)
            install_brew_deps "$class"
            ;;
        finish)
            log "INFO" "Machine class: $class"
            if [[ ! -r "$XDG_CONFIG_HOME/mise/config.app-preferences.toml" ]]; then
                log "ERROR" "Missing app preference profile; deploy the alternates and run yadm alt." >&2
                return 1
            fi
            MISE_CEILING_PATHS="$HOME" "$HOME/.local/bin/mise" -C "$HOME" -E app-preferences \
                bootstrap dotfiles apply
            MISE_CEILING_PATHS="$HOME" "$HOME/.local/bin/mise" -C "$HOME" -E app-preferences \
                bootstrap --only macos-defaults
            setup_docker_buildx
            setup_yadm
            log "SUCCESS" "Setup completed successfully"
            ;;
    esac
}

main "$@"
