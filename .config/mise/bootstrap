#!/bin/bash

set -euo pipefail
IFS=$'\n\t'

# Constants
readonly TYPOGRAPHY_VERSION="3.9"
readonly DOWNLOADS_TIMEOUT=300
readonly CONNECT_TIMEOUT=15

# Logger function
log() {
    local level=$1
    shift
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] [$level] $*"
}

# Error handler
error_handler() {
    local line_num=$1
    local error_code=$2
    log "ERROR" "Failed at line ${line_num} with error code ${error_code}"
    exit "${error_code}"
}

trap 'error_handler ${LINENO} $?' ERR

# Check if running on macOS
check_macos() {
    if [[ "$OSTYPE" != "darwin"* ]]; then
        log "ERROR" "This script is intended for macOS only"
        exit 1
    fi
}

# One class policy for native bootstrap hooks and directly invoked phases.
read_machine_class() {
    local class
    if ! class=$(git config --no-includes --file "$XDG_DATA_HOME/yadm/repo.git/config" --get local.class); then
        log "ERROR" "Cannot read yadm local.class. Run: yadm config local.class home (or work)" >&2
        return 1
    fi
    case "$class" in
        home|work) printf '%s\n' "$class" ;;
        *)
            log "ERROR" "Invalid yadm local.class '$class'; expected home or work." >&2
            return 1
            ;;
    esac
}

# Load configuration
load_config() {
    cd "$HOME"
    source "$HOME"/.xdg.dirs
    source "$XDG_CONFIG_HOME"/shell/xdg
    export HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"
    export PATH="$HOME/.local/bin:$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin:$PATH"
}

# Install brew dependencies
install_brew_deps() {
    local class=$1
    log "INFO" "Installing brew dependencies (class: $class)..."
    "$HOMEBREW_PREFIX/bin/brew" bundle
    log "SUCCESS" "Brew dependencies installation completed"
}

# Apply defaults
apply_defaults() {
    log "INFO" "Applying defaults..."

    find "$XDG_CONFIG_HOME" -type f -name "defaults" -print0 | while IFS= read -r -d '' file; do
        # Check if the file is executable and execute it
        if [ -x "$file" ]; then
            # Execute the file
            /bin/bash "$file" --no-restart
        fi
    done

    log "SUCCESS" "Defaults applied successfully"
}


# Configure docker-buildx
setup_docker_buildx() {
    log "INFO" "Configuring docker-buildx..."
    mkdir -p "$DOCKER_CONFIG/cli-plugins"
    ln -sfn "$HOMEBREW_PREFIX/opt/docker-buildx/bin/docker-buildx" "$DOCKER_CONFIG/cli-plugins/docker-buildx"
    log "SUCCESS" "Docker-buildx configured"
}

# Download application
download_app() (
    local url=$1
    local filename=$2
    local timeout=$3

    if [ -f "$filename" ]; then
        log "INFO" "File $filename already exists, skipping download"
        return 0
    fi

    local temporary
    temporary=$(mktemp "${filename}.part.XXXXXX")
    trap 'rm -f "$temporary"' EXIT
    log "INFO" "Downloading $filename..."
    curl -fL -o "$temporary" --connect-timeout "$CONNECT_TIMEOUT" \
        --max-time "$timeout" "$url"
    mv -f "$temporary" "$filename"
    trap - EXIT
    log "SUCCESS" "Downloaded $filename"
)

# Download all applications
download_apps() {
    local class=$1
    cd "$XDG_DOWNLOAD_DIR"

    # Typography Layout (all machines)
    download_app \
        "https://ilyabirman.ru/typography-layout/download/ilya-birman-typolayout-$TYPOGRAPHY_VERSION-mac.dmg" \
        "ilya-birman-typolayout-$TYPOGRAPHY_VERSION-mac.dmg" \
        "$DOWNLOADS_TIMEOUT"

    # Home-only downloads
    if [[ "$class" == "home" ]]; then
        # Amnezia VPN
        local AMNEZIA
        AMNEZIA=$(curl -fsSL --connect-timeout "$CONNECT_TIMEOUT" \
            --max-time "$DOWNLOADS_TIMEOUT" \
            "https://api.github.com/repos/amnezia-vpn/amnezia-client/releases/latest" \
            | jq -er '.tag_name | select(type == "string" and length > 0)')
        local AMNEZIA_VERSION="${AMNEZIA#v}"
        download_app \
            "https://github.com/amnezia-vpn/amnezia-client/releases/download/$AMNEZIA/AmneziaVPN_$AMNEZIA_VERSION.dmg" \
            "AmneziaVPN_$AMNEZIA_VERSION.dmg" \
            "$DOWNLOADS_TIMEOUT"

        # Yandex.Disk
        download_app \
            "https://disk.yandex.ru/download/Yandex.Disk.dmg/?instant=1" \
            "Yandex.Disk.dmg" \
            "$DOWNLOADS_TIMEOUT"
    fi

    cd "$HOME"
}

# Configure yadm
setup_yadm() {
    log "INFO" "Configuring yadm sparse-checkout..."
    "$HOMEBREW_PREFIX/bin/yadm" sparse-checkout init
    "$HOMEBREW_PREFIX/bin/yadm" sparse-checkout set --no-cone \
        '/*' '!README.md' '!LICENSE' '!.editorconfig' \
        '!MISE-ASSESSMENT.md' '!MACKUP-REMOVAL-PLAN.md' '!/tests/'
    log "SUCCESS" "Yadm configured"
}

main() {
    local phase=${1:-}
    case "$phase" in
        preflight|packages|defaults|finish) ;;
        *)
            log "ERROR" "Usage: $0 {preflight|packages|defaults|finish}"
            exit 1
            ;;
    esac

    check_macos
    load_config

    local class
    class=$(read_machine_class)
    if [[ "$phase" == "preflight" ]]; then
        return 0
    fi
    chmod 700 "$XDG_CONFIG_HOME"

    case "$phase" in
        packages)
            install_brew_deps "$class"
            ;;
        defaults)
            /bin/bash "$XDG_CONFIG_HOME/macos/defaults-extra"
            apply_defaults
            ;;
        finish)
            log "INFO" "Machine class: $class"
            if [[ ! -r "$XDG_CONFIG_HOME/mise/config.app-preferences.toml" ]]; then
                log "ERROR" "Missing app preference profile; deploy the alternates and run yadm alt." >&2
                return 1
            fi
            MISE_CEILING_PATHS="$HOME" "$HOME/.local/bin/mise" -C "$HOME" -E app-preferences \
                bootstrap dotfiles apply
            setup_docker_buildx
            download_apps "$class"
            setup_yadm
            log "SUCCESS" "Setup completed successfully"
            ;;
    esac
}

main "$@"
